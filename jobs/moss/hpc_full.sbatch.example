#!/bin/bash
# MOSS-Image's full fine-tune over several GPUs on a Slurm cluster: FSDP2 (diffu_moss.train.distributed) launched by
# torchrun, one node or several. Set for Leonardo's Booster (partition, QOS, 4 A100 64 GB a node); the account comes
# from SBATCH_ACCOUNT and the paths from the environment (REPO, MOSS_BASE, CACHE, OUT). The debug QOS allows a short
# walltime only: submit the smoke test with --time=00:30:00 on the command line. docs/MOSS_HPC.md is the runbook.
# Tested on CPU only (gloo, world size 2, tiny models): no run on real GPUs yet.
#
# Memory, estimated per GPU before any run (one sample a micro-batch, a 1 MP target and a 0.5 MP reference, ~2k prompt
# tokens): the float32 weights, gradients, Muon momentum and AdamW moments sharded over N GPUs, 62.2 / N GB; ~8 GB of
# activations; ~1.5 GB of bfloat16 blocks gathered for the forward and backward and of float32 gradients being
# reduced; ~0.5 GB of one matrix gathered whole for Muon; ~4 GB for CUDA and NCCL; with --encode-text the text
# encoder's 16.8 GB on every GPU; with --ema 62.2 -> 82.5 / N GB. On A100s (Leonardo's are 64 GB, so every row below fits):
#   4 GPUs (one node):  ~30 GB, ~47 GB with --encode-text, ~52 GB with both
#   8 GPUs (two nodes): ~22 GB, ~39 GB with --encode-text, ~42 GB with both
# A checkpoint is gathered whole to the main rank's host memory one file at a time, each held only while it is written
# (10 GB for the bfloat16 DiT; with --save-state at most ~22 GB, the optimizer state, then 20 GB of float32 weights), and
# each rank loads the DiT whole on the CPU before it is sharded (~20 GB of host memory a rank).
#
# Each step's --samples-per-step samples are shared out evenly among the GPUs (a multiple of their number): one
# micro-batch each per round. The data must sit on a filesystem every node reads (the cache, the DiT, the run dir).
#
#SBATCH --job-name=moss-full
#SBATCH --nodes=1                 # 2 for 8 GPUs on 4-GPU nodes
#SBATCH --ntasks-per-node=1       # one torchrun per node; it starts a process per GPU
#SBATCH --gres=gpu:4               # a Leonardo Booster node: 4 A100 64 GB, 32 cores
#SBATCH --cpus-per-task=32
#SBATCH --mem=0                   # the node's memory: each rank loads the DiT on the CPU before sharding it
#SBATCH --time=24:00:00
#SBATCH --output=moss-full-%j.out
#SBATCH --partition=boost_usr_prod  # Leonardo's GPU partition (its default partition is CPU-only)
#SBATCH --qos=boost_qos_dbg         # the smoke test; normal for a run of a few nodes (boost_qos_bprod has a minimum size)
# the account comes from SBATCH_ACCOUNT in the cluster's ~/.bashrc, never from this file

set -euo pipefail
export HF_HUB_OFFLINE=1          # compute nodes have no internet: the models are staged before

REPO="${REPO:?set REPO to the repository checkout on the cluster}"
BASE="${MOSS_BASE:?set MOSS_BASE to the MOSS-Image Base snapshot}"
CACHE="${CACHE:?set CACHE to a diffu-moss-cache-pairs cache}"
VAL_CACHE="${VAL_CACHE:-}"
OUT="${OUT:?set OUT to the run directory}"
STEPS="${STEPS:-500}"
SAVE_EVERY="${SAVE_EVERY:-250}"
VAL_EVERY="${VAL_EVERY:-$SAVE_EVERY}"
EMA="${EMA:-}"            # e.g. 0.999: an average of the weights saved beside each checkpoint
RESUME="${RESUME:-}"      # a checkpoint saved with --save-state, or "latest": the newest whole one under $OUT
GRADIENT_CHECKPOINTING="${GRADIENT_CHECKPOINTING:-1}"  # 0: keep the blocks' activations (faster; ~40 GB free a GPU on 8 A100 64 GB)
UNCHECKPOINTED_BLOCKS="${UNCHECKPOINTED_BLOCKS:-0}"  # with checkpointing: the last N of the 42 blocks keep their activations
PROFILE_DIR="${PROFILE_DIR:-}"  # a folder: steps 4 to 6 recorded by torch's profiler, a trace a rank (diagnostic)
RESHARD_AFTER_FORWARD="${RESHARD_AFTER_FORWARD:-1}"  # 0: keep each block's gathered weights for its backward (~10 GB a GPU, half the gathers)
GPUS_PER_NODE="${GPUS_PER_NODE:-4}"
SAMPLES_PER_STEP="${SAMPLES_PER_STEP:-$((SLURM_NNODES * GPUS_PER_NODE * 2))}"  # two rounds of one sample a GPU

# site modules or a container go here; the repository's own environment:
PY="$REPO/.venv/bin/python"

HEAD_NODE="$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)"
export OMP_NUM_THREADS=8

options=(--full --transformer "$BASE/transformer" --cache "$CACHE" --out "$OUT" --steps "$STEPS"
    --samples-per-step "$SAMPLES_PER_STEP" --save-every "$SAVE_EVERY" --val-every "$VAL_EVERY" --save-state)
[ -n "$VAL_CACHE" ] && options+=(--val-cache "$VAL_CACHE")
[ -n "$EMA" ] && options+=(--ema "$EMA")
[ "$GRADIENT_CHECKPOINTING" = 0 ] && options+=(--no-gradient-checkpointing)
[ "$UNCHECKPOINTED_BLOCKS" != 0 ] && options+=(--uncheckpointed-blocks "$UNCHECKPOINTED_BLOCKS")
[ -n "$PROFILE_DIR" ] && options+=(--profile-dir "$PROFILE_DIR")
[ "$RESHARD_AFTER_FORWARD" = 0 ] && options+=(--no-reshard-after-forward)
# a cache of latents alone (diffu-moss-cache-pairs --latents-only): encode the prompts in the step
# options+=(--encode-text --model "$REPO/runs/moss/base")
# go on from a checkpoint saved with --save-state, on any number of GPUs; "latest" takes the newest whole one (its
# state's progress.json is written last), so a chain of jobs (sbatch --dependency=afterany:<previous>) goes on job to
# job, and the first job of a chain, finding none, starts from Base:
if [ "$RESUME" = latest ]; then
    for checkpoint in $(ls -d "$OUT"/checkpoints/step_* 2>/dev/null | sort -r); do
        if [ -f "$checkpoint/state/progress.json" ]; then
            options+=(--resume "$checkpoint")
            break
        fi
    done
elif [ -n "$RESUME" ]; then
    options+=(--resume "$RESUME")
fi
echo "options: ${options[*]}"

srun "$PY" -m torch.distributed.run \
    --nnodes "$SLURM_NNODES" --nproc-per-node "$GPUS_PER_NODE" \
    --rdzv-backend c10d --rdzv-endpoint "$HEAD_NODE:29500" --rdzv-id "$SLURM_JOB_ID" \
    -m diffu_moss.train.loop "${options[@]}"

# On one node without Slurm, the same run:
#   torchrun --standalone --nproc-per-node 4 -m diffu_moss.train.loop --full --transformer <snapshot>/transformer \
#       --cache <cache> --out <run> --steps 500 --samples-per-step 8 --save-state
