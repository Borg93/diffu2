  "cards": [
    {
      "dot": "emerald",
      "title": "Where the fold is",
      "items": [
        "Cutting by the old labels' line positions left strips of the facing page and threw away 154,874 scans",
        "The gutter network is off by more than 1 % of the width on 36 % of ordinary openings",
        "The placer, searching 6 % either side of the middle, is off on 3 %"
      ]
    },
    {
      "dot": "violet",
      "title": "Whether to cut at all",
      "items": [
        "10 % of scans must not be cut: tables across the fold, single pages, odd layouts",
        "The VL model's first form misses 58 % of them",
        "A classifier trained on the bulk marks finds 95 %"
      ]
    },
    {
      "dot": "amber",
      "title": "What the marks cost",
      "items": [
        "200 fold clicks took 17 minutes and settled which cutter to trust",
        "14,985 scans were marked in a gallery, cluster by cluster",
        "Few-shot examples for the VL model gave no gain: 86 % to 88 %"
      ]
    }
  ]
